# ── Logto (Auth) ───────────────────────────────────────────────────────────────
LOGTO_APP_ID=your-app-id-here
LOGTO_APP_SECRET=your-app-secret-here
LOGTO_ENDPOINT=http://localhost:3001
LOGTO_BASE_URL=http://localhost:3000
LOGTO_COOKIE_SECRET=generate-with-openssl-rand-hex-32
LOGTO_API_RESOURCE=http://localhost:8080

# ── Backend ────────────────────────────────────────────────────────────────────
BACKEND_API_URL=http://localhost:8080

# ── Calculadora (servidor separado) ───────────────────────────────────────────
CALCULATOR_API_URL=http://localhost:9599
CALCULATOR_API_KEY=

# ── Producto ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PRODUCT_ID=03d17890-251f-4946-bb91-49d35ff62800
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:9599/api

# ── Legal ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_TERMS_URL=https://tudominio.com/terminos-y-condiciones

# ── Environment ────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Instructions ───────────────────────────────────────────────────────────────
# 1. Copy this file to .env.local
# 2. Replace placeholders with your actual values
# 3. Generate LOGTO_COOKIE_SECRET with: openssl rand -hex 32
# 4. LOGTO_API_RESOURCE must match the API Resource registered in Logto
#    AND the audience the backend validates in the JWT
